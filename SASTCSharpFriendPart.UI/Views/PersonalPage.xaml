<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SASTCSharpFriendPart_UI.Views.PersonalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Storyboard x:Name="EntranceAnimation">
            <DoubleAnimation
                Storyboard.TargetName="MainBorder"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.35" />
        </Storyboard>
    </Page.Resources>

    <ScrollViewer Padding="20" Width="Auto" Height="Auto">
        <Border
            x:Name="MainBorder"
            Width="750"
            Height="450"
            HorizontalAlignment="Center"
            Padding="32"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="个人信息" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="管理你的个人资料" />
                </StackPanel>

                <Border
                    Padding="16"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="当前名称" />
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsNotEditing, Mode=OneWay}" />
                        <TextBox
                            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="个人简介" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsNotEditing, Mode=OneWay}" />
                    <TextBox
                        MinHeight="30"
                        MaxHeight="70"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.EditCommand}"
                        Content="编辑资料"
                        Visibility="{x:Bind ViewModel.EditButtonVisible, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="取消"
                        Visibility="{x:Bind ViewModel.CancelButtonVisible, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="保存"
                        Visibility="{x:Bind ViewModel.SaveButtonVisible, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
