<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SASTCSharpFriendPart_UI.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <Page.Resources>
        <Storyboard x:Name="EntranceAnimation">
            <DoubleAnimation
                Storyboard.TargetName="MainBorder"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.35" />
        </Storyboard>

        <DataTemplate x:Key="ContactTemplate">
            <Grid Padding="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="44"
                    Height="44"
                    CornerRadius="22">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding PreviewText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="11"
                    Text="{Binding PreviewTime}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate">
            <Grid>
                <StackPanel
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    Visibility="{Binding FriendVisibility}">
                    <Border
                        Padding="14,10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4,14,14,14">
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        Margin="2,5,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="11"
                        Text="{Binding Time}" />
                </StackPanel>

                <StackPanel
                    MaxWidth="420"
                    HorizontalAlignment="Right"
                    Visibility="{Binding MineVisibility}">
                    <Border
                        Padding="14,10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14,4,14,14">
                        <TextBlock Foreground="White" Text="{Binding Content}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        Margin="0,5,2,0"
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="11"
                        Text="{Binding Time}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Border
            x:Name="MainBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="240" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Padding="20,22,12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="消息" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="和动物朋友聊聊天" />
                        </StackPanel>
                        <Button
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Right"
                            Content="+"
                            FontSize="16"
                            ToolTipService.ToolTip="新建聊天" />
                    </Grid>

                    <AutoSuggestBox
                        Grid.Row="1"
                        Margin="0,20,8,12"
                        PlaceholderText="搜索好友"
                        QueryIcon="Find" />

                    <ListView
                        Grid.Row="2"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource DefaultListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Contacts}"
                        ItemTemplate="{StaticResource ContactTemplate}"
                        SelectedItem="{x:Bind ViewModel.SelectedContact, Mode=TwoWay}" />

                    <Border
                        Grid.Row="3"
                        Margin="0,14,8,0"
                        Padding="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="18" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="在线" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="4 位朋友陪伴中" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="22,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.SelectedContact.Name, Mode=OneWay}" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="#4CAF72" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="uPhone 325 在线 - 799G" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            Content="&#xE712;"
                            FontSize="16"
                            FontFamily="Segoe MDL2 Assets"
                            ToolTipService.ToolTip="更多选项" />
                    </Grid>

                    <Grid Grid.Row="1" Padding="24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="今天" />
                        <ListView
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            BorderThickness="0"
                            IsItemClickEnabled="False"
                            IsTabStop="False"
                            ItemsSource="{x:Bind ViewModel.SelectedContact.Messages, Mode=OneWay}"
                            ItemTemplate="{StaticResource MessageTemplate}"
                            SelectionMode="None" />
                    </Grid>

                    <Grid Grid.Row="2" Padding="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="&#xE723;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="添加附件" />
                            <Button Content="&#xEB9F;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="添加图片" />
                            <Button Content="&#xE76E;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="添加表情" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <TextBox MinHeight="44" Padding="12,8" PlaceholderText="输入消息..." />
                            <Button
                                Width="38"
                                Height="38"
                                Margin="0,3,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Content="&#xE724;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="White"
                                ToolTipService.ToolTip="发送" />
                        </Grid>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Column="2" Padding="20,24">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="好友资料" />
                        <Border
                            Width="96"
                            Height="96"
                            Margin="0,24,0,14"
                            HorizontalAlignment="Center"
                            CornerRadius="48">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind ViewModel.SelectedContact.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedContact.Name, Mode=OneWay}" />
                        <StackPanel Margin="0,8,0,24" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="8" Height="8" Fill="#4CAF72" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="在线" />
                        </StackPanel>
                        <Border
                            Padding="14"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="关于 TA" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedContact.Description, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,26,0,10" FontWeight="SemiBold" Text="快捷操作" />
                        <Button HorizontalAlignment="Stretch" Content="查看 Ta 的资料卡" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="共享的媒体" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
